{
  "name": "@lks347/dsh-notebook",
  "version": "1.0.0",
  "type": "module",
  "description": "Research notebooks, source-based Q&A, and study tools in DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakeofsky347/dsh-notebook.git"
  },
  "homepage": "https://github.com/lakeofsky347/dsh-notebook#readme",
  "bugs": {
    "url": "https://github.com/lakeofsky347/dsh-notebook/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./library": "./src/library.js",
    "./assets/*": "./lib/assets/*"
  },
  "files": [
    "src",
    "lib/assets",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "node dev/serve.mjs",
    "test:ui": "node dev/check.mjs",
    "preview:particles": "node dev/record-particles.mjs",
    "preview:motion": "node dev/record-particles.mjs"
  },
  "dependencies": {
    "linkedom": "0.18.14"
  }
}
