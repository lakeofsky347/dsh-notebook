{
  "name": "dsh-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness notebook workbench: model conversations, resource collection, sources, and Studio artifacts.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./library": "./src/library.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "node dev/serve.mjs",
    "test:ui": "node dev/check.mjs",
    "preview:particles": "node dev/record-particles.mjs"
  },
  "dependencies": {
    "linkedom": "0.18.14"
  }
}
